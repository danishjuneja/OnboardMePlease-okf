# Optional capture deadline for large repositories (default 2h):
# APP_CAPTURE_TIMEOUT=2h

# Default installation performs no model calls. MODEL_MODE is strict_local.
# Native local embedding adapter (the URL must use a loopback IP):
# LOCAL_EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# LOCAL_EMBEDDING_MODEL=your-local-embedding-model
# LOCAL_EMBEDDING_DIMENSIONS=768
# For cloud opt-in in Compose, use compose.cloud.yaml and a protected
# secrets/openai_api_key.txt file. No key belongs in this .env file.
