# Compose reads this file only after you copy it to .env.
# Only APP_CAPTURE_TIMEOUT and GENERATION_MODEL are interpolated by Compose.
# APP_CAPTURE_TIMEOUT=2h
# GENERATION_MODEL=your-model-id

# Native execution: set these in your shell; the Go service does not load .env.
# DATABASE_URL_FILE=/path/to/database-url.txt
# APP_DATA_DIR=/path/to/private-data
# MODEL_MODE=strict_local
# GENERATION_PROVIDER=local
# GENERATION_MODEL=your-local-model
# LOCAL_GENERATION_URL=http://127.0.0.1:11434/v1/chat/completions
# LOCAL_EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# LOCAL_EMBEDDING_MODEL=your-local-embedding-model
# LOCAL_EMBEDDING_DIMENSIONS=768

# Cloud Compose: use compose.cloud.yaml and secrets/openai_api_key.txt.
# Do not put passwords or API keys in this file.
