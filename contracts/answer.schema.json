{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumption": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "section",
          "concept",
          "evidence_ids",
          "assumption"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": "integer"
          },
          "end_line": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "path",
          "start_line",
          "end_line",
          "content",
          "source_kind"
        ],
        "additionalProperties": false
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "markdown",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagram": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "kind",
          "evidence_id"
        ],
        "additionalProperties": false
      }
    },
    "retrieval": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "question",
    "parent_id",
    "claims",
    "sources",
    "concepts",
    "gaps",
    "diagram",
    "retrieval",
    "created_at"
  ],
  "additionalProperties": false
}
