{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onboardmeplease.local/contracts/analysis.schema.json",
  "title": "Claims, overviews, flows and answers",
  "$defs": {
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "kind", "evidence_ids", "profile_ids", "conditions", "support_status"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["fact", "inference", "unresolved"] },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "profile_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "support_status": { "enum": ["supported", "partial", "unsupported", "contradicted", "not_assessed"] },
        "assumption": { "type": "string" },
        "reasoning_note": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["fact", "inference"] } } }, "then": { "properties": { "evidence_ids": { "minItems": 1 } } } },
        { "if": { "properties": { "kind": { "const": "inference" } } }, "then": { "required": ["assumption"], "properties": { "assumption": { "minLength": 1 } } } }
      ]
    },
    "Limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "related_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "OverviewSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "claim_ids"],
      "properties": {
        "kind": { "enum": ["purpose", "interfaces", "runtime", "components", "startup", "deployment", "data", "flows", "start_exploring", "coverage"] },
        "title": { "type": "string", "minLength": 1 },
        "claim_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "component_ids": { "type": "array", "items": { "type": "string" } },
        "source_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "snapshot_id", "state", "sections", "claims", "limitations", "coverage_snapshot_id"],
      "properties": {
        "repository_id": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["partial", "ready", "stale"] },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/OverviewSection" } },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/Claim" } },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/Limitation" } },
        "coverage_snapshot_id": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time", "description": "Assigned by application clock" }
      }
    },
    "FlowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "claim_ids", "symbol_ids", "incoming_relation_ids", "outgoing_relation_ids"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "symbol_ids": { "type": "array", "items": { "type": "string" } },
        "incoming_relation_ids": { "type": "array", "items": { "type": "string" } },
        "outgoing_relation_ids": { "type": "array", "items": { "type": "string" } },
        "boundary": { "enum": ["none", "async", "external", "unresolved", "cycle", "truncated"] }
      }
    },
    "TechnicalAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "snapshot_id", "status", "claim_ids", "steps", "limitations", "considered_evidence_ids"],
      "properties": {
        "repository_id": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["complete", "partial", "insufficient_evidence"] },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/FlowStep" } },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/Limitation" } },
        "considered_evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "followup_questions": { "type": "array", "items": { "type": "string" }, "maxItems": 3 }
      }
    }
  }
}
