{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "contradicted"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "assessments"
  ],
  "additionalProperties": false
}
