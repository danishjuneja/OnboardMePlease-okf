{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "section": {
            "type": "string",
            "enum": [
              "purpose",
              "components",
              "interfaces",
              "runtime",
              "startup",
              "deployment",
              "data",
              "flows",
              "start_exploring",
              "coverage",
              "answer"
            ]
          },
          "concept": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumption": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "section",
          "concept",
          "evidence_ids",
          "assumption"
        ],
        "additionalProperties": false
      },
      "maxItems": 24
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 6
    }
  },
  "required": [
    "claims",
    "gaps"
  ],
  "additionalProperties": false
}
